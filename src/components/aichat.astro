      <div class="inputAI">
        <div class="search-input">
          <input
            class="search-input inputSub"
            maxlength="128"
            type="text"
            autocomplete="off"
            placeholder="选型补充说明"
          />
          <div class="close-iocn"></div>
        </div>
      </div>
      <div class="submit">
        <button class="btn">搜索</button>
