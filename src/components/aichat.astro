---
import { api } from "../api/index.ts";
let selectData = await api.getSelect();
---

<style lang="less">
  #AiChat {
    display: none;
    background-color: #fff;
    width: 450px;
    min-width: 450px;
    position: fixed;
    right: 4.5%;
    top: 64px;
    z-index: 1000;
    padding: 20px 30px;
    max-height: 90%;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    height: 90%;
    min-height: 500px;
    // overflow-y: auto;
    // display: flex;
    flex-direction: column;
    .topbar {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 18px;
      .left {
        font-weight: 700;
      }
      .right {
        cursor: pointer;
        i {
          background-image: url(../assets/cancel-icon.svg);
          background-position: 50% 50%;
          background-repeat: no-repeat;
          background-size: 100%;
          cursor: pointer;
          height: 12px;
          margin-top: -6px;
          position: absolute;
          right: 6%;
          top: 30px;
          width: 12px;
          transition: all 0.3s;
          &:hover {
            background-image: url(../assets/cancel-icon-h.png);
          }
        }
      }
      &::after {
        content: "";
        border-style: solid;
        border-width: 5px 0px 0px;
        border-image: linear-gradient(
            270deg,
            rgb(235, 134, 152) 0%,
            rgb(19, 102, 236) 100%
          )
          1 / 1 / 0 stretch;
        position: absolute;
        top: 0px;
        left: 0px;
        width: 100%;
      }
    }

    .selectionList {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
      .selection {
        display: flex;
        .allcontent {
          flex: auto;
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
          gap: 5px;
          .selected-box {
            @media screen and (max-width: 768px) {
              width: 100%;
              margin-top: 4px;
              font-size: 1rem;
            }
            form {
              padding: 0 40px 0 0;
              display: flex;
              align-items: center;
              @media screen and (max-width: 768px) {
                padding: 0;
              }
              .select-title {
                white-space: nowrap;
                margin-right: 3px;
                font-weight: 600;
              }
              & > div {
                display: flex;
                flex: 1;
              }
              label {
                display: flex;
                height: auto;
                padding: 0 6px;
                cursor: pointer;
                width: 50%;
                @media screen and (max-width: 768px) {
                  width: 33%;
                }
                input {
                  cursor: pointer;
                  margin-right: 2px;
                  @media screen and (max-width: 768px) {
                    transform: scale(0.6);
                    transform-origin: center;
                  }
                }
                span {
                  white-space: nowrap;
                  &:hover {
                    color: @primary-blue;
                  }
                }
              }
            }
          }
        }
      }
      .inputSubmit {
        flex-shrink: 0;
        margin-top: 10px;
        display: flex;
        .inputAI {
          width: 80%;
          p {
            text-align: center;
            padding: 20px 0;
            font-size: 14px;
            @media screen and (max-width: 768px) {
              font-size: 1rem;
            }
          }
          .search-input {
            width: 100%;
            height: 75px;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            @media screen and (max-width: 768px) {
              width: 97%;
            }
            .search-input {
              border-color: #595959;
              background-color: #fff;
              border: 1px solid #b8b8b8;
              border-radius: 8px;
              color: #191919;
              font-size: 16px;
              height: 40px;
              line-height: 24px;
              outline: none;
              padding: 8px 23px 8px 15px;
              position: absolute;
              box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.078);
              @media screen and (max-width: 768px) {
                font-size: 1rem;
                height: 34px;
                padding: 8px 40px;
              }
            }
            .close-iocn {
              background-image: url(../assets/cancel-icon.svg);
              background-position: 50% 50%;
              background-repeat: no-repeat;
              background-size: 100%;
              cursor: pointer;
              height: 12px;
              margin-top: -6px;
              position: absolute;
              right: 3%;
              top: 50%;
              width: 12px;
              transition: all 0.3s;
              @media screen and (max-width: 768px) {
                right: 25px;
              }
              &:hover {
                background-image: url(../assets/cancel-icon-h.png);
              }
            }
          }
        }
        .submit {
          margin-left: 15px;
          display: flex;
          align-items: center;
          height: 75px;
          .btn {
            height: 40px;
            display: inline-block;
            padding: 8px 40px;
            font-size: 15px;
            line-height: 1;
            border-radius: 6px;
            color: #409eff; /* 主题色 */
            background-color: #ecf5ff; /* 背景浅蓝 */
            border: 1px solid #b3d8ff;
            cursor: pointer;
            transition: all 0.3s;
            user-select: none;
          }

          .btn:hover {
            color: white;
            background-color: #409eff; /* hover时变成纯蓝色 */
            border-color: #409eff;
          }

          .btn:active {
            background-color: #337ecc; /* 按下时颜色更深 */
            border-color: #337ecc;
          }
        }
      }

      .reply {
        flex: 1;
        margin-top: 20px;
        overflow-y: auto;
        height: 100%;
        .messages {
          width: 100%;
          max-height: 100%;
          height: 100%;
          overflow-y: auto;
          /* 滚动条 */
          scrollbar-color: hsla(228, 7%, 74%, 0.6) transparent;
          scrollbar-width: thin;
          // height: 300px;
          padding: 16px;
          border-radius: 8px;
          background-color: #fff;
          //   box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
          // margin-bottom: 20px;
          font-size: 16px;
          line-height: 1.6;
          color: #333;
          .message {
            height: 100%;
            line-height: 1.2;
            overflow-y: auto;
            font-size: 14px;
          }
          .loading {
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 22px;
          }
        }
      }
    }
  }
</style>
