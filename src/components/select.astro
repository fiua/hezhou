---
import SelectionList from "./selectionList.astro";
import SelectionAI from "./selectionAI.astro";
---

<style lang="less">
  #select {
    width: 100%;
    padding-top: 10px;
    scroll-margin-top: 50px;
    // margin-top: 64px;
    @media screen and (max-width: 768px) {
      padding-top: 2rem;
    }
    .boxShadow();
    padding-bottom: 45px;
    font-size: 1.4rem;
    .select-nav-container {
      width: 100%;
      border-bottom: 0.8px solid #e5e5e5;
      @media screen and (max-width: 768px) {
        height: auto;
      }

      .select-nav {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 91%;
        margin: 0 auto;
        font-size: 28px;
        font-weight: 700;
        @media screen and (max-width: 768px) {
          width: 100%;
          margin: 0 auto;
        }
        div {
          padding: 30px 0 30px 0;
          cursor: pointer;
          @media screen and (max-width: 768px) {
            font-size: 1rem;
            margin: 0 2rem;
            padding: 0;
          }

          span {
            border-radius: 20px;
            transition: all 0.3s;
            position: relative;
            display: inline-block;
            @media screen and (max-width: 768px) {
              padding: 5px 0;
            }
          }
        }
      }
    }

    .select-container {
      width: 91%;
      margin: 0 auto;
      @media screen and (max-width: 768px) {
        width: 100%;
      }

      .select-content {
        margin-top: 20px;
        @media screen and (max-width: 768px) {
          margin-top: 1rem;
        }
      }
    }
  }
</style>
<section id="select">
  <div class="select-nav-container">
    <div class="select-nav">
      <div><span>AI选型帮助</span></div>
    </div>
  </div>
  <div class="select-container">
    <div class="select-content">
      <div>
        <SelectionList />
      </div>
      <div>
        <!-- <SelectionAI /> -->
      </div>
    </div>
  </div>
</section>
<script></script>
