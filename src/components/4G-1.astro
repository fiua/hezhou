---
const { products } = Astro.props;
import { Image } from "astro:assets";
const images = import.meta.glob("../assets/images/4g-1/*.png", {
  eager: true,
  import: "default",
});
const availableImages = new Set(
  Object.keys(images).map((key) => key.split("/").pop())
);
---

<style lang="less">
  .right-1 {
    height: 100%;
    display: flex;
    // padding: 30px 40px 0;
    flex-wrap: wrap;
    //每个盒子
    > div {
      // padding: 0 50px;
      flex: 1 1 26%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      .border();
      @media screen and (max-width: 768px) {
        padding: 0;
      }
      &:hover {
        .boxLinear();
        h5 {
          color: @primary-blue;
        }
      }
      h5 {
        font-size: 14px;
        text-align: center;
        font-weight: 600;
        @media screen and (max-width: 768px) {
          font-size: 0.8rem;
        }
      }
      > p {
        text-align: center;
        padding: 5px 0;
        font-size: 12px;
        @media screen and (max-width: 768px) {
          font-size: 0.6rem;
        }
      }
      //图片组
      > div {
        display: flex;
        align-content: center;
        width: 100%;
        // 每个图片
        > div {
          flex: 1;
          display: flex;
          justify-content: center;
          align-items: center;
          flex-direction: column;

          .region {
            font-size: 12px;
            @media screen and (max-width: 768px) {
              font-size: 0.6rem;
            }
          }
          .pic {
            width: 76px;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 5px 0;
            @media screen and (max-width: 768px) {
              width: 47px;
              padding: 0;
              margin: 0 3px;
            }
            img {
              @media screen and (max-width: 768px) {
                width: 50%;
              }
            }
          }
        }
      }
      .itemname {
        @media screen and (max-width: 768px) {
          font-size: 0.6rem;
          padding: 0.4rem 0;
        }
      }
    }
  }
</style>
<div class="right-1">
  {
    products.map((product: any) => {
      // 先检查 product.title 是否存在，避免解构错误
      const title = product.category ?? "";
      const features = product.features ?? "";

      return (
        <div>
          <h5>{title}</h5>
          <p>{features}</p>
          <div>
            {product.modules?.map((item: any) => {
              return (
                <div>
                  <div class="region">
                    {"region" in item ? item.region : ""}
                  </div>

                  <div class="pic">
                    {/* <img src=`/images/4g-1/${item.image}.png` alt="" loading="lazy"/> */}
                    {typeof item.image === "string" &&
                    availableImages.has(item.image + ".png") ? (
                      // 从 glob 映射中取出资源对象（而不是字符串路径）
                      <Image
                        src={
                          images[
                            `../assets/images/4g-1/${item.image}.png`
                          ] as ImageMetadata
                        }
                        alt={item.image}
                      />
                    ) : (
                      item.image
                    )}
                  </div>
                  <div class="itemname">{item.name}</div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })
  }
</div>
